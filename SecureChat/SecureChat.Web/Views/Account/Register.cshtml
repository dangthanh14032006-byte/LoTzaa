@{
    ViewData["Title"] = "Đăng ký";
}

<div class="login-container">

    <div class="login-box">

        <h1>🔐 hihihi</h1>

        <p class="subtitle">
            Tạo tài khoản mới
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="success-message">
                @ViewBag.Success
            </div>
        }

        <form method="post">
            <input type="hidden" name="publicKey" />

            <div class="form-group">
                <label>Số điện thoại</label>

                <div style="display:flex; gap:8px;">
                    <input type="tel"
                           id="phoneNumber"
                           name="phoneNumber"
                           placeholder="VD: 0901234567"
                           style="flex:1;"
                           required />

                    <button type="button"
                            id="btnSendOtp"
                            class="login-button"
                            style="width:auto; white-space:nowrap; padding:0 14px;">
                        Gửi mã OTP
                    </button>
                </div>
            </div>

            <div class="form-group" id="otpGroup" style="display:none;">
                <label>Mã OTP (6 số)</label>

                <input type="text"
                       id="otpCode"
                       name="otpCode"
                       maxlength="6"
                       inputmode="numeric"
                       placeholder="Nhập mã OTP..." />

                <div id="otpDemoBanner"
                     style="display:none; margin-top:6px; padding:8px; border-radius:6px;
                    background:#fff3cd; color:#664d03; font-size:0.9em;">
                </div>
            </div>

            <div class="form-group">
                <label>Tên đăng nhập</label>

                <input type="text"
                       name="username"
                       placeholder="Nhập tên đăng nhập..."
                       required />
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>

                <input type="password"
                       name="password"
                       placeholder="Nhập mật khẩu..."
                       required />
            </div>

            <div class="form-group">
                <label>Nhập lại mật khẩu</label>

                <input type="password"
                       name="confirmPassword"
                       placeholder="Nhập lại mật khẩu..."
                       required />
            </div>

            <button class="login-button"
                    type="submit">
                Đăng ký
            </button>

        </form>

        <p class="register-text">
            Đã có tài khoản?
            <a href="/">Đăng nhập</a>
        </p>

    </div>

</div>
@section Scripts {
    <script src="~/js/securechat-crypto.js"></script>
    <script>
        const form = document.querySelector("form");
        const btnSendOtp = document.getElementById("btnSendOtp");
        const otpGroup = document.getElementById("otpGroup");
        const otpDemoBanner = document.getElementById("otpDemoBanner");
        const phoneInput = document.getElementById("phoneNumber");
        const otpInput = document.getElementById("otpCode");
        let otpSentForPhone = null;

        btnSendOtp.addEventListener("click", async () => {
            const phoneNumber = phoneInput.value.trim();
            if (!phoneNumber) { alert("Vui lòng nhập số điện thoại."); return; }

            btnSendOtp.disabled = true;
            btnSendOtp.textContent = "Đang gửi...";

            try {
                const resp = await fetch("/Account/SendOtp", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "phoneNumber=" + encodeURIComponent(phoneNumber),
                });
                const data = await resp.json();

                if (!data.ok) {
                    alert(data.error || "Không gửi được mã OTP.");
                    return;
                }

                otpSentForPhone = phoneNumber;
                otpGroup.style.display = "block";
                otpDemoBanner.style.display = "block";
                otpDemoBanner.innerHTML =
                    "⚠️ <b>Chế độ demo</b> (chưa nối SMS thật): mã OTP của bạn là " +
                    "<b style='font-size:1.2em'>" + data.demoCode + "</b>" +
                    " (hết hạn sau 5 phút).";
                otpInput.focus();
            } catch (err) {
                alert("Lỗi khi gửi OTP: " + err.message);
            } finally {
                btnSendOtp.disabled = false;
                btnSendOtp.textContent = "Gửi mã OTP";
            }
        });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (otpSentForPhone === null) {
                alert("Vui lòng bấm \"Gửi mã OTP\" và nhập mã trước khi đăng ký.");
                return;
            }
            if (!otpInput.value.trim()) {
                alert("Vui lòng nhập mã OTP.");
                return;
            }

            try {
                form.publicKey.value =
                    await SC.generatePending(form.username.value.trim());
                form.submit();
            } catch (err) {
                alert("Không sinh được khóa RSA: " + err.message);
            }
        });

        @if (ViewBag.Success != null)
        {
                    <text>SC.commitPending("@ViewBag.RegisteredUser");</text>
        }
    </script>
}